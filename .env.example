# Copy to .env.local. Without these the app runs in local-only mode (IndexedDB + BroadcastChannel).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Token Maker background removal under `npm run dev` (server-side only: never prefix it with VITE_).
# In Cloud deployments set it as a Supabase Edge Function secret instead (README, "Token maker setup").
# OPENAI_API_KEY=sk-...

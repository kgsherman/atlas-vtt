  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\" \"e2e/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\" \"e2e/**/*.mjs\" \"scripts/**/*.mjs\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview"

    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@supabase/supabase-js": "^2.117.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.13.2",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "three": "^0.186.0",
